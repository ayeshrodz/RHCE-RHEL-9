#!/usr/bin/env bash
# lab - starts and finishes exercises on the Playbook Path home lab
# (same syntax as a classroom 'lab' command). Runs on workstation as student.
# Install or update: see section 0.6 of the guide, or run: lab update
# Version 2
set -uo pipefail

VERSION=2
BASE="${LAB_URL:-https://ayeshrodz.github.io/playbook-path/lab}"
ARCHIVE="$HOME/lab-archive"
SERVERS=(servera serverb serverc serverd)

say()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }
fetch() { curl -fsSL --retry 2 "$BASE/$1"; }

usage() {
cat <<USAGE
lab v$VERSION - Playbook Path home lab exercises

  lab start  NAME [--force]    create ~/NAME with the exercise's starter files
  lab finish NAME [--delete]   put ~/NAME away in ~/lab-archive (or delete it)
  lab grade  NAME              how to check your work (no grading at home)
  lab list                     exercises that have starter files
  lab check                    is the lab ready for the exercises?
  lab update                   download the newest version of this command
  lab version

lab works on workstation only. The managed hosts are reset from the Ubuntu
host, because the lab network cannot reach the host:  rht-vmctl reset servers
Starter files come from: $BASE
USAGE
}

need_name() { [[ -n ${1:-} ]] || die "which exercise? e.g. 'lab $SUB playbook-basic' (see: lab list)"; }
valid_name() { [[ $1 =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "'$1' is not an exercise name"; }
stamp() { date +%Y%m%d-%H%M%S; }

cmd_start() {
  need_name "${1:-}"; valid_name "$1"
  local name="$1" force="${2:-}" dir="$HOME/$1" manifest line dest src hooks=() h tmp count=0
  manifest=$(fetch "$name/MANIFEST" 2>/dev/null) || die "no exercise called '$name', or no connection to $BASE (see: lab list)"
  [[ $manifest == \#* ]] || die "unexpected answer from $BASE/$name/MANIFEST"

  if [[ -e $dir ]]; then
    [[ $force == --force ]] || die "~/$name already exists. Keep working in it, put it away with 'lab finish $name', or start over with 'lab start $name --force'"
    mkdir -p "$ARCHIVE" && mv "$dir" "$ARCHIVE/$name-$(stamp)" && warn "your previous ~/$name is now in ~/lab-archive"
  fi
  mkdir -p "$dir" || die "cannot create ~/$name"
  say "$(head -1 <<< "$manifest" | sed 's/^# *//')"

  while IFS= read -r line; do
    line="${line%%#*}"; line="${line//[[:space:]]/}"
    [[ -z $line ]] && continue
    if [[ $line == @* ]]; then hooks+=("${line#@}"); continue; fi
    dest="${line%%=*}"; src="${line#*=}"
    [[ $dest == /* || $dest == *..* || $src == *..* ]] && die "refusing unsafe path in manifest: $line"
    mkdir -p "$dir/$(dirname "$dest")"
    fetch "$name/$src" > "$dir/$dest" || die "could not download $src"
    echo "  $dest"; count=$((count + 1))
  done <<< "$manifest"

  for h in "${hooks[@]:-}"; do
    [[ -n $h ]] || continue
    tmp=$(mktemp)
    fetch "$name/$h" > "$tmp" || die "could not download $h"
    (cd "$dir" && bash "$tmp") || warn "$h reported a problem"
    rm -f "$tmp"
  done
  (( count == 0 && ${#hooks[@]} == 0 )) && echo "  (no starter files: you write everything in this exercise)"

  say "~/$name is ready:  cd ~/$name"
  echo "  Start from clean servers: on the Ubuntu host, run  rht-vmctl reset servers"
}

cmd_finish() {
  need_name "${1:-}"; valid_name "$1"
  local name="$1" opt="${2:-}" dir="$HOME/$1" dest
  if [[ ! -e $dir ]]; then
    warn "there is no ~/$name on workstation (already finished?)"
  elif [[ $opt == --delete ]]; then
    rm -rf "$dir" && say "deleted ~/$name"
  else
    [[ $PWD == "$dir" || $PWD == "$dir"/* ]] && cd "$HOME"
    dest="$ARCHIVE/$name-$(stamp)"
    mkdir -p "$ARCHIVE" && mv "$dir" "$dest" && say "moved ~/$name to ~/lab-archive/$(basename "$dest")"
    echo "  Your work is kept there. 'lab start $name' gives you a fresh copy."
  fi
  echo "  One step is left, and only the Ubuntu host can do it:  rht-vmctl reset servers"
  echo "  (lab runs inside the sealed lab network, so it cannot reset the machines itself)"
}

cmd_grade() {
  need_name "${1:-}"
  warn "there is no automatic grading on the home lab"
  echo "  Check your work with the verification tasks at the end of the exercise,"
  echo "  then run the playbook a second time: it should report changed=0."
}

cmd_list() { fetch INDEX || die "no connection to $BASE"; }

cmd_check() {
  local h u bad=0 missing=""
  ok() { printf '  \033[32mPASS\033[0m %s\n' "$1"; }
  ko() { printf '  \033[31mFAIL\033[0m %s\n' "$1"; bad=1; }
  for h in workstation "${SERVERS[@]}"; do
    missing=""
    for u in devops student root; do
      ssh -o BatchMode=yes -o ConnectTimeout=5 "$u@$h" true 2>/dev/null || missing+=" $u"
    done
    if [[ -z $missing ]]; then ok "$h: key login as devops, student and root"; else ko "$h: no key login as:$missing"; fi
  done
  if ansible-galaxy collection list 2>/dev/null | grep -q '^ansible.posix'; then ok "ansible.posix collection"; else ko "ansible.posix collection"; fi
  if fetch INDEX >/dev/null 2>&1; then ok "starter files reachable"; else ko "cannot reach $BASE"; fi
  if (( bad )); then
    echo
    echo "  Missing key logins on the servers usually mean the 'clean' baseline was saved"
    echo "  before they were set up, and a reset removed them. Repeat steps 5 and 6 of"
    echo "  section 0.6, then on the Ubuntu host run:  rht-vmctl save"
    return 1
  fi
  say "the lab is ready"
}

cmd_update() {
  local self tmp
  self=$(readlink -f "$0"); tmp=$(mktemp)
  fetch lab > "$tmp" || die "could not download $BASE/lab"
  bash -n "$tmp" || die "the downloaded file is not a valid script; nothing changed"
  install -m 755 "$tmp" "$self" && rm -f "$tmp"
  say "updated $self: $("$self" version)"
}

SUB="${1:-help}"; shift || true
case "$SUB" in
  start)             cmd_start "$@" ;;
  finish)            cmd_finish "$@" ;;
  grade)             cmd_grade "$@" ;;
  list)              cmd_list ;;
  check)             cmd_check ;;
  update)            cmd_update ;;
  version|--version) echo "lab $VERSION" ;;
  help|-h|--help)    usage ;;
  *)                 usage; exit 1 ;;
esac
