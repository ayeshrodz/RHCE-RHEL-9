{
  "kp-assessment-timer": {
    "prefix": "kp-assessment-timer",
    "description": "An optional countdown for a timed practice assessment; survives reloads.",
    "body": [
      "{% assessment-timer id=\"${1}\" /%}"
    ]
  },
  "kp-callout": {
    "prefix": "kp-callout",
    "description": "A highlighted note beside the main text.",
    "body": [
      "{% callout type=\"${1|note,tip,important,warning,exam|}\" title=\"${2}\" %}",
      "$0",
      "{% /callout %}"
    ]
  },
  "kp-card": {
    "prefix": "kp-card",
    "description": "One card in a card grid, with a heading, an optional kicker and a tone.",
    "body": [
      "{% card title=\"${1}\" %}",
      "$0",
      "{% /card %}"
    ]
  },
  "kp-cards": {
    "prefix": "kp-cards",
    "description": "A responsive grid of cards that stacks on small screens.",
    "body": [
      "{% cards cols=${1:1} %}",
      "\t$0",
      "{% /cards %}"
    ]
  },
  "kp-column": {
    "prefix": "kp-column",
    "description": "One column in a two-column layout.",
    "body": [
      "{% column title=\"${1}\" tone=\"${2|gray,purple,teal,coral,pink,blue,green,amber,red|}\" %}",
      "$0",
      "{% /column %}"
    ]
  },
  "kp-columns": {
    "prefix": "kp-columns",
    "description": "Two side-by-side columns that stack on small screens.",
    "body": [
      "{% columns %}",
      "\t$0",
      "{% /columns %}"
    ]
  },
  "kp-diagram": {
    "prefix": "kp-diagram",
    "description": "A diagram of boxes, groups and arrows. It can be static, let the reader select boxes to read an explanation, or step through a sequence.",
    "body": [
      "{% diagram ref=\"${1}\" /%}"
    ]
  },
  "kp-flashcards": {
    "prefix": "kp-flashcards",
    "description": "A deck of flip cards for recall.",
    "body": [
      "{% flashcards ref=\"${1}\" /%}"
    ]
  },
  "kp-flow-map": {
    "prefix": "kp-flow-map",
    "description": "A responsive sequence of steps with an explanation panel.",
    "body": [
      "{% flow-map ref=\"${1}\" /%}"
    ]
  },
  "kp-glossary": {
    "prefix": "kp-glossary",
    "description": "A list of terms and definitions.",
    "body": [
      "{% glossary %}",
      "\t$0",
      "{% /glossary %}"
    ]
  },
  "kp-kbd": {
    "prefix": "kp-kbd",
    "description": "A keyboard key, such as Esc or Ctrl+C.",
    "body": [
      "{% kbd %}",
      "$0",
      "{% /kbd %}"
    ]
  },
  "kp-lab": {
    "prefix": "kp-lab",
    "description": "A hands-on exercise with tracked tasks, notes and an optional challenge brief.",
    "body": [
      "{% lab id=\"${1}\" title=\"${2}\" %}",
      "\t$0",
      "{% /lab %}"
    ]
  },
  "kp-lab-challenge": {
    "prefix": "kp-lab-challenge",
    "description": "The requirements brief shown in Challenge mode.",
