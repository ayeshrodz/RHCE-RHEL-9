{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelpath.dev/schema/v1/data/flashcards.schema.json",
  "title": "Flashcard deck",
  "type": "object",
  "additionalProperties": false,
  "required": ["cards"],
  "properties": {
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["front", "back"],
        "properties": {
          "front": { "$ref": "../common.schema.json#/$defs/inlineMarkdown" },
          "back": { "$ref": "../common.schema.json#/$defs/inlineMarkdown" }
        }
      }
    }
  }
}
