{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelpath.dev/schema/v1/data/quiz.schema.json",
  "title": "Quiz bank",
  "description": "Multiple-choice questions for a {% quiz %} tag. Every knowledge check in a program uses this one format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions"],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "q", "options", "answer", "explain"],
        "properties": {
          "id": { "type": "string", "pattern": "^q-[a-z0-9]{6,32}$" },
          "legacyIndex": { "type": "integer", "minimum": 0 },
          "q": { "$ref": "../common.schema.json#/$defs/inlineMarkdown" },
          "code": { "type": "string", "maxLength": 4000 },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "uniqueItems": true,
            "items": { "$ref": "../common.schema.json#/$defs/inlineMarkdown" }
          },
          "answer": { "type": "integer", "minimum": 0, "maximum": 5 },
          "explain": { "$ref": "../common.schema.json#/$defs/inlineMarkdown" }
        }
      }
    }
  }
}
