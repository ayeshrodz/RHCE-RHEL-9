{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelpath.dev/schema/v1/data/kits/build-roadmap.schema.json",
  "title": "Build roadmap",
  "description": "The words and data for the build roadmap kit: A checklist-style roadmap of the steps to build the practice lab.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "data"
  ],
  "properties": {
    "text": {
      "type": "object",
      "maxProperties": 30,
      "additionalProperties": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phases"
      ],
      "properties": {
        "phases": {
          "type": "array",
          "maxItems": 28,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "n",
              "title",
              "min",
              "where",
              "slug"
            ],
            "properties": {
              "n": {
                "type": "string",
                "maxLength": 4000
              },
              "title": {
                "type": "string",
                "maxLength": 4000
              },
              "min": {
                "type": "integer"
              },
              "where": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "maxLength": 4000
                }
              },
              "slug": {
                "type": "string",
                "maxLength": 4000
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "description": "Copy for kits this kit shows inside itself, by kit name.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
  }
}
