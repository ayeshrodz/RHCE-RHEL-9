{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelpath.dev/schema/v1/data/kits/admin-module-finder.schema.json",
  "title": "Admin module finder",
  "description": "The words and data for the admin module finder kit: Finds the module for a system administration job.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "data"
  ],
  "properties": {
    "text": {
      "type": "object",
      "maxProperties": 30,
      "additionalProperties": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areas",
        "initialSelection1"
      ],
      "properties": {
        "areas": {
          "type": "object",
          "maxProperties": 30,
          "additionalProperties": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "maxLength": 4000
              }
            }
          }
        },
        "initialSelection1": {
          "type": "string",
          "maxLength": 4000
        }
      }
    }
  }
}
