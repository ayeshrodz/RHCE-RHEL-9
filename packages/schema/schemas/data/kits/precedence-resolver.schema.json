{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelpath.dev/schema/v1/data/kits/precedence-resolver.schema.json",
  "title": "Precedence resolver",
  "description": "The words and data for the precedence resolver kit: Shows which of several competing settings wins when they are toggled on and off.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "data"
  ],
  "properties": {
    "text": {
      "type": "object",
      "maxProperties": 30,
      "additionalProperties": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false
    },
    "props": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "items",
        "fallback"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 4000
        },
        "sub": {
          "type": "string",
          "maxLength": 4000
        },
        "items": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "detail"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 4000
              },
              "detail": {
                "type": "string",
                "maxLength": 4000
              },
              "on": {
                "type": "boolean"
              }
            }
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "detail"
          ],
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 4000
            },
            "detail": {
              "type": "string",
              "maxLength": 4000
            }
          }
        },
        "note": {
          "type": "string",
          "maxLength": 4000
        },
        "winnerLabel": {
          "type": "string",
          "maxLength": 4000
        }
      }
    }
  }
}
