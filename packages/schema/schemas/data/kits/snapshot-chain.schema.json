{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelpath.dev/schema/v1/data/kits/snapshot-chain.schema.json",
  "title": "Snapshot chain",
  "description": "The words and data for the snapshot chain kit: A step-through of lab snapshots and how each one builds on the last.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "data"
  ],
  "properties": {
    "text": {
      "type": "object",
      "maxProperties": 39,
      "additionalProperties": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "names"
      ],
      "properties": {
        "names": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    }
  }
}
