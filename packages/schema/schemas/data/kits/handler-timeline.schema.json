{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelpath.dev/schema/v1/data/kits/handler-timeline.schema.json",
  "title": "Handler timeline",
  "description": "The words and data for the handler timeline kit: A timeline showing when notified handlers run relative to tasks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "data"
  ],
  "properties": {
    "text": {
      "type": "object",
      "maxProperties": 45,
      "additionalProperties": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks",
        "handlers"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "notify"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 4000
              },
              "notify": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "maxLength": 4000
                }
              }
            }
          }
        },
        "handlers": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    }
  }
}
