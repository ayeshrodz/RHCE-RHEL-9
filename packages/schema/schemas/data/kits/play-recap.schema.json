{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelpath.dev/schema/v1/data/kits/play-recap.schema.json",
  "title": "Play recap",
  "description": "The words and data for the play recap kit: Explains each part of a play recap line and what the counters mean.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "data"
  ],
  "properties": {
    "text": {
      "type": "object",
      "maxProperties": 30,
      "additionalProperties": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counters",
        "initialSelection1"
      ],
      "properties": {
        "counters": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value",
              "tone",
              "text"
            ],
            "properties": {
              "key": {
                "type": "string",
                "maxLength": 4000
              },
              "value": {
                "type": "integer"
              },
              "tone": {
                "type": "string",
                "maxLength": 4000
              },
              "text": {
                "type": "string",
                "maxLength": 4000
              }
            }
          }
        },
        "initialSelection1": {
          "type": "string",
          "maxLength": 4000
        }
      }
    }
  }
}
