{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelpath.dev/schema/v1/data/kits/magic-variables.schema.json",
  "title": "Magic variables",
  "description": "The words and data for the magic variables kit: Shows what each built-in variable holds for a given host.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "data"
  ],
  "properties": {
    "text": {
      "type": "object",
      "maxProperties": 30,
      "additionalProperties": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory",
        "fqdn",
        "initialSelection1"
      ],
      "properties": {
        "inventory": {
          "type": "string",
          "maxLength": 4000
        },
        "fqdn": {
          "type": "object",
          "maxProperties": 30,
          "additionalProperties": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "initialSelection1": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "dependencies": {
      "description": "Copy for kits this kit shows inside itself, by kit name.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
  }
}
