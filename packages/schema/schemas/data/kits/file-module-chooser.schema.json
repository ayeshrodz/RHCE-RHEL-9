{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelpath.dev/schema/v1/data/kits/file-module-chooser.schema.json",
  "title": "File module chooser",
  "description": "The words and data for the file module chooser kit: Helps pick the file module that fits a described job.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "data"
  ],
  "properties": {
    "text": {
      "type": "object",
      "maxProperties": 30,
      "additionalProperties": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goals",
        "initialSelection1"
      ],
      "properties": {
        "goals": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "maxProperties": 30,
            "additionalProperties": {
              "type": "string",
              "maxLength": 4000
            }
          }
        },
        "initialSelection1": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "dependencies": {
      "description": "Copy for kits this kit shows inside itself, by kit name.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
  }
}
