{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelpath.dev/schema/v1/bundle/site.schema.json",
  "title": "Compiled site index",
  "description": "site.json, the bundle's entry point. The only unhashed content file: the engine reads it first and follows its hashed URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "generatedAt",
    "site",
    "programs"
  ],
  "properties": {
    "apiVersion": {
      "$ref": "../common.schema.json#/$defs/apiVersion"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tagline"
      ],
      "properties": {
        "name": {
          "$ref": "../common.schema.json#/$defs/shortText"
        },
        "tagline": {
          "$ref": "../common.schema.json#/$defs/shortText"
        },
        "description": {
          "$ref": "../common.schema.json#/$defs/text"
        },
        "repo": {
          "$ref": "../common.schema.json#/$defs/url"
        },
        "links": {
          "type": "array"
        },
        "legal": {
          "$ref": "../common.schema.json#/$defs/inlineMarkdown"
        },
        "theme": {
          "$ref": "../source/theme.schema.json"
        },
        "home": {
          "$ref": "#/$defs/hashedUrl"
        }
      }
    },
    "ui": {
      "description": "Content overrides of engine UI strings, by locale and component.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "programs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "label",
          "platform",
          "status",
          "summary",
          "manifest"
        ],
        "properties": {
          "id": {
            "$ref": "../common.schema.json#/$defs/id"
          },
          "title": {
            "$ref": "../common.schema.json#/$defs/shortText"
          },
          "label": {
            "$ref": "../common.schema.json#/$defs/shortText"
          },
          "tagline": {
            "$ref": "../common.schema.json#/$defs/shortText"
          },
          "summary": {
            "$ref": "../common.schema.json#/$defs/text"
          },
          "platform": {
            "$ref": "../source/program.schema.json#/properties/platform"
          },
          "status": {
            "enum": [
              "active",
              "planned"
            ]
          },
          "theme": {
            "$ref": "../source/theme.schema.json"
          },
          "sections": {
            "type": "integer",
            "minimum": 0
          },
          "manifest": {
            "$ref": "#/$defs/hashedUrl"
          },
          "showcase": {
            "$ref": "../source/program.schema.json#/properties/showcase"
          }
        }
      }
    },
    "lab": {
      "description": "Where the lab tools download exercises from, relative to the bundle.",
      "type": "string",
      "const": "lab/"
    },
    "signature": {
      "$ref": "#/$defs/hashedUrl"
    },
    "interface": {
      "description": "Shared interface copy file.",
      "$ref": "#/$defs/hashedUrl"
    }
  },
  "$defs": {
    "hashedUrl": {
      "description": "A path inside the bundle whose file name carries a content hash.",
      "type": "string",
      "pattern": "^(?:p/[a-z0-9-]+/)?(?:[a-z]+/)*[a-z0-9-]+\\.[a-f0-9]{8,64}\\.(?:json|sig)$"
    }
  }
}
