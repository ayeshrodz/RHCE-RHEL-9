{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernelpath.dev/schema/v1/bundle/legacy.schema.json",
  "title": "Legacy interface bundle",
  "description": "Transitional: the course and track metadata and the program-specific interface copy (landing page, dashboard). Replaced by engine string defaults with content overrides.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "course",
    "track",
    "interface"
  ],
  "properties": {
    "apiVersion": {
      "$ref": "../common.schema.json#/$defs/apiVersion"
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "tagline"
      ],
      "properties": {
        "title": {
          "$ref": "../common.schema.json#/$defs/shortText"
        },
        "tagline": {
          "$ref": "../common.schema.json#/$defs/shortText"
        },
        "repo": {
          "$ref": "../common.schema.json#/$defs/url"
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 200
      },
      "required": [
        "id",
        "label",
        "platform"
      ],
      "properties": {
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "path"
          ],
          "properties": {
            "title": {
              "$ref": "../common.schema.json#/$defs/shortText"
            },
            "eyebrow": {
              "$ref": "../common.schema.json#/$defs/shortText"
            },
            "description": {
              "$ref": "../common.schema.json#/$defs/text"
            },
            "path": {
              "const": "/platform"
            }
          }
        }
      }
    },
    "interface": {
      "description": "Copy catalogs that belong to this program (landing page, dashboard), by component name.",
      "$ref": "interface.schema.json#/properties/interface"
    }
  }
}
