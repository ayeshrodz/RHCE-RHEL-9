    "lab": {
      "summary": "A hands-on exercise with tracked tasks, notes and an optional challenge brief.",
      "status": "stable",
      "since": 1,
      "placement": "block",
      "children": "tags",
      "attributes": {
        "id": {
          "type": "string",
          "description": "Stable id; task progress is stored under it.",
