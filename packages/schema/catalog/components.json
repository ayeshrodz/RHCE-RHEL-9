          "format": "shortText"
        },
        "exercise": {
          "type": "string",
          "description": "The lab tools exercise name (`lab start NAME`).",
          "format": "exerciseName"
        },
        "ownExercise": {
          "type": "boolean",
          "description": "The exercise exists only on this platform; there is no classroom equivalent.",
          "default": false
