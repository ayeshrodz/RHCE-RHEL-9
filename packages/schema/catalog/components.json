          "type": "string[]",
          "description": "What the learner will have done.",
          "format": "text",
          "maxItems": 12
        },
        "objectives": {
          "type": "string[]",
          "description": "Objectives the exercise practises.",
          "format": "objectiveId",
          "maxItems": 12
        }
      },
      "allowedChildren": [
        "task",
        "lab-notes",
        "lab-challenge",
        "lab-setup"
      ],
      "required": [
        "id",
        "title"
      ]
