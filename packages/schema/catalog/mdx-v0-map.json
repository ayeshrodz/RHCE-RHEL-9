{
  "description": "How each MDX component used before apiVersion 1 becomes a catalog tag. Attribute renames are listed per component; 'fixed' attributes are added by the conversion; any component not listed is a legacy widget (legacy-widget name=<Component>).",
  "components": {
    "Lead": { "tag": "lead" },
    "Objectives": { "tag": "objectives" },
    "Callout": { "tag": "callout" },
    "Cards": { "tag": "cards" },
    "Card": { "tag": "card" },
    "Columns": { "tag": "columns" },
    "Column": { "tag": "column" },
    "Tabs": { "tag": "tabs" },
    "Tab": { "tag": "tab" },
    "Reveal": { "tag": "reveal" },
    "Steps": { "tag": "steps" },
    "Step": { "tag": "step" },
    "Glossary": { "tag": "glossary" },
    "Term": { "tag": "term" },
    "kbd": { "tag": "kbd" },
    "div": { "tag": "callout", "fixed": { "type": "important" }, "dropAttributes": ["className"] },
    "Quiz": { "tag": "quiz", "dataAttribute": "questions", "dataShape": "quiz" },
    "ChapterPractice": { "tag": "practice", "dataAttribute": "challenges", "dataShape": "practice", "dropAttributes": ["chapter"] },
    "Flashcards": { "tag": "flashcards", "dataAttribute": "cards", "dataShape": "flashcards" },
    "AssessmentTimer": { "tag": "assessment-timer" },
    "Lab": { "tag": "lab", "rename": { "classroom": "exercise", "own": "ownExercise" }, "transform": { "exercise": "strip-lab-start" } },
    "Task": { "tag": "task" },
    "LabNotes": { "tag": "lab-notes" },
    "LabChallenge": { "tag": "lab-challenge" },
    "HomeSetup": { "tag": "lab-setup", "fixed": { "variant": "homelab" } },
    "Finish": { "tag": "lab-finish", "rename": { "name": "exercise" } },
    "StarterFiles": { "tag": "starter-files", "rename": { "name": "exercise" } },
    "Env": { "tag": "variant-group" },
    "Classroom": { "tag": "variant", "fixed": { "name": "classroom" } },
    "HomeLab": { "tag": "variant", "fixed": { "name": "homelab" } },
    "EnvSwitch": { "tag": "variant-switch" },
    "LabValues": { "tag": "reader-variables" },
    "FlowMap": { "tag": "flow-map", "dataAttributes": ["steps", "connections"], "dataShape": "flow-map" }
  }
}
